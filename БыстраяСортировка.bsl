////////////////////////////////////////////////////////////////////////////////
// Модуль: алгоритмы сортировки.
// Содержит реализацию быстрой сортировки (QuickSort) для массива значений.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Сортирует массив по месту методом быстрой сортировки (сравнение через «меньше»).
// Подходит для массивов из чисел, дат, строк (сравнимых через < и >).
//
// Параметры:
//  Массив - Массив из Число, Дата, Строка - сортируемый массив (изменяется на месте).
//  ИндексНачала - Число - левая граница диапазона (по умолчанию 0).
//  ИндексКонеца - Число - правая граница диапазона (по умолчанию верхняя граница массива).
//
// Пример:
//  МассивЧисел = Новый Массив;
//  МассивЧисел.Добавить(3);
//  МассивЧисел.Добавить(1);
//  МассивЧисел.Добавить(2);
//  АлгоритмыСортировки.ВыполнитьБыструюСортировку(МассивЧисел);
//  // МассивЧисел: 1, 2, 3
//
Процедура ВыполнитьБыструюСортировку(Массив, ИндексНачала = 0, ИндексКонеца = Неопределено) Экспорт
	ИндексВерхнейГраницы = ИндексКонеца;
	Если ИндексВерхнейГраницы = Неопределено Тогда
		ИндексВерхнейГраницы = Массив.ВГраница();
	КонецЕсли;
	ВыполнитьРазделениеИСортировку(Массив, ИндексНачала, ИндексВерхнейГраницы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет рекурсивное разделение по опорному элементу и сортирует подмассивы.
//
// Параметры:
//  Массив - Массив - сортируемый массив.
//  ИндексЛевойГраницы - Число - начало диапазона.
//  ИндексПравойГраницы - Число - конец диапазона.
//
Процедура ВыполнитьРазделениеИСортировку(Массив, ИндексЛевойГраницы, ИндексПравойГраницы)
	Если ИндексЛевойГраницы >= ИндексПравойГраницы Тогда
		Возврат;
	КонецЕсли;
	ОпорныйЭлемент = Массив[ИндексПравойГраницы];
	ИндексРазделения = ИндексЛевойГраницы;
	Для Индекс = ИндексЛевойГраницы По ИндексПравойГраницы - 1 Цикл
		Если Массив[Индекс] < ОпорныйЭлемент Тогда
			ПоменятьМестамиЭлементы(Массив, Индекс, ИндексРазделения);
			ИндексРазделения = ИндексРазделения + 1;
		КонецЕсли;
	КонецЦикла;
	ПоменятьМестамиЭлементы(Массив, ИндексРазделения, ИндексПравойГраницы);
	ВыполнитьРазделениеИСортировку(Массив, ИндексЛевойГраницы, ИндексРазделения - 1);
	ВыполнитьРазделениеИСортировку(Массив, ИндексРазделения + 1, ИндексПравойГраницы);
КонецПроцедуры

// Меняет местами два элемента массива по индексам.
//
// Параметры:
//  Массив - Массив - массив для обмена.
//  ИндексПервый - Число - индекс первого элемента.
//  ИндексВторой - Число - индекс второго элемента.
//
Процедура ПоменятьМестамиЭлементы(Массив, ИндексПервый, ИндексВторой)
	ВременноеЗначение = Массив[ИндексПервый];
	Массив[ИндексПервый] = Массив[ИндексВторой];
	Массив[ИндексВторой] = ВременноеЗначение;
КонецПроцедуры

#КонецОбласти
